            "export QML2_IMPORT_PATH=/usr/lib/sdk/qt611/lib/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
          ],
          "dest-filename": "enable.sh"
        }
      ]
    },
    {
      "name": "appdata",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm0644 -t ${FLATPAK_DEST}/share/metainfo/ ${FLATPAK_ID}.metainfo.xml"
